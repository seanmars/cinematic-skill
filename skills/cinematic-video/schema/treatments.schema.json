{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "treatments.schema.json",
  "title": "Cinematic video treatments",
  "description": "The three pitched treatments. After sign-off the chosen content is expanded into storyboard.json; unchosen options stay here as a record.",
  "type": "object",
  "required": ["options", "chosen"],
  "additionalProperties": false,
  "properties": {
    "options": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/option" } },
    "chosen": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["id"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "mix": {
              "type": "array",
              "description": "Elements borrowed from other options.",
              "items": {
                "type": "object",
                "required": ["option", "element"],
                "additionalProperties": false,
                "properties": {
                  "option": { "$ref": "#/$defs/id" },
                  "element": { "$ref": "#/$defs/text" }
                }
              }
            },
            "notes": { "$ref": "#/$defs/text" }
          }
        }
      ]
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Z]$" },
    "text": { "type": "string", "minLength": 1 },
    "option": {
      "type": "object",
      "required": ["id", "title", "logline", "look", "specs", "stack", "shots", "signatureMoves", "audio", "estimate", "risk", "whyItFits", "preview"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "$ref": "#/$defs/text" },
        "logline": { "$ref": "#/$defs/text" },
        "look": {
          "type": "object",
          "required": ["description", "palette", "typefaces"],
          "additionalProperties": false,
          "properties": {
            "description": { "$ref": "#/$defs/text" },
            "palette": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" } },
            "typefaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
          }
        },
        "specs": { "$ref": "#/$defs/text" },
        "stack": { "$ref": "#/$defs/text" },
        "cta": { "$ref": "#/$defs/text", "description": "Commercial only." },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["range", "text"],
            "additionalProperties": false,
            "properties": {
              "range": { "type": "string", "pattern": "^[0-9.]+[–-][0-9.]+s$" },
              "text": { "$ref": "#/$defs/text" }
            }
          }
        },
        "signatureMoves": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } },
        "audio": { "$ref": "#/$defs/text" },
        "estimate": { "$ref": "#/$defs/text" },
        "risk": { "$ref": "#/$defs/text" },
        "whyItFits": { "$ref": "#/$defs/text" },
        "preview": { "type": "string", "minLength": 1, "description": "Style frame path, relative to the project directory." },
        "motionTest": { "type": "string", "minLength": 1, "description": "Optional 2-4s motion test path for motion-driven treatments, relative to the project directory." }
      }
    }
  }
}
